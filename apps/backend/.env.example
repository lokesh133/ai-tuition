PORT=5000
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Deepgram / Voice TTS API (Optional)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Video Avatar Streaming APIs (Optional for Photorealistic Human Video Teacher)
HEYGEN_API_KEY=your_heygen_api_key_here
DID_API_KEY=your_did_api_key_here
SIMLI_API_KEY=your_simli_api_key_here

# Redis Cache (Optional, fallback to in-memory cache if not provided)
REDIS_URL=redis://localhost:6379

# Client CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost:8081
